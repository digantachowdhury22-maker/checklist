{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/graphql",
            "destination": "/api/graphql"
        },
        {
            "source": "/health",
            "destination": "/api/health"
        }
    ]
}